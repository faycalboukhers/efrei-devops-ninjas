# Staging Environment Variables
# Copy this file to .env.staging and fill with real values

# Database
POSTGRES_PASSWORD_STAGING=your_secure_password_here
DATABASE_URL=postgres://metro_user:your_secure_password_here@postgres:5432/metro_db

# Application
NODE_ENV=staging
PORT=5000

# Docker Image
STAGING_IMAGE=registry.gitlab.com/your-username/dernier-metro-api:staging

# Optional: External services
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=info