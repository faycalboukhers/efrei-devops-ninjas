# Production Environment Variables
# NEVER commit this file with real passwords!

# Database
POSTGRES_PASSWORD_PROD=your_very_secure_production_password_here
DATABASE_URL=postgres://metro_user:your_very_secure_production_password_here@postgres-blue:5432/metro_db

# Docker Images
BLUE_IMAGE=dernier-metro-api:blue
GREEN_IMAGE=dernier-metro-api:green
PROD_IMAGE=dernier-metro-api:production

# Application
NODE_ENV=production

# Monitoring (optional)
# SENTRY_DSN=
# LOG_LEVEL=error